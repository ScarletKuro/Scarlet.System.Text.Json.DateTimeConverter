<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeAotTests)' == 'true'">
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);NATIVE_AOT_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeAotTests)' == 'true'">
    <!-- These tests intentionally exercise reflection-based serialization. -->
    <Compile Remove="ReflectionBasedTests*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" Version="4.0.2" />
  </ItemGroup>

  <!-- Coverage is collected from the managed run; the native binary is published without a collector. -->
  <ItemGroup Condition="'$(NativeAotTests)' != 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scarlet.System.Text.Json.DateTimeConverter\Scarlet.System.Text.Json.DateTimeConverter.csproj" />
    <!-- Root the whole library so AOT publish analyzes every method, not only the ones tests touch. -->
    <TrimmerRootAssembly Include="Scarlet.System.Text.Json.DateTimeConverter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
